# Gabarit des variables attendues. AUCUNE VALEUR SENSIBLE ICI : ce fichier est le
# seul `.env*` versionne. Les valeurs reelles vivent dans `.env.local` (0600,
# ignore par Git) en local, et dans le gestionnaire de secrets du service en
# staging/production. Ordre de lecture Next : process.env, .env.$NODE_ENV.local,
# .env.local, .env.$NODE_ENV, .env.

# URL publique du site, utilisee par les metadonnees, robots.txt et sitemap.xml.
# OBLIGATOIRE en production : sans elle, les URL canoniques, le sitemap et le
# robots.txt retombent sur http://localhost:3000 (cf. src/lib/site-url.ts).
# Valeur attendue en production : https://www.eliottbouquerel.fr
# (domaine arrete : eliottbouquerel.fr, servi sur le sous-domaine www ; ce
# n'est pas un secret, la ligne reste vide ici par coherence du gabarit).
NEXT_PUBLIC_SITE_URL=

# Le contenu vient des modules TS de `src/content/` et des articles MDX de
# `content/blog/`. Il n'y a plus ni base de donnees ni CMS : les variables
# CONTENT_SOURCE, DATABASE_URI et PAYLOAD_* ont disparu avec Payload
# (2026-08-26). Voir docs/BLOG.md.

# ---------------------------------------------------------------------------
# MESURE D'AUDIENCE — PostHog
#
# ABSENCE DE VALEUR = SITE NORMAL, MESURE ETEINTE. Sans NEXT_PUBLIC_POSTHOG_KEY,
# le SDK n'est jamais telecharge, aucune requete ne part, et la banniere de
# consentement ne s'affiche meme pas : il n'y a rien a consentir. C'est l'etat
# par defaut du depot, et il est teste.
#
# Cle de PROJET, publique par construction : elle voyage dans chaque requete
# emise par le navigateur et n'autorise que l'ecriture d'evenements. Ce n'est
# PAS un secret. La cle d'API personnelle de PostHog, elle, en est un et n'a
# rien a faire ici.
#
# OU LA TROUVER : posthog.com -> creer un compte sur la REGION EUROPE (le choix
# de region est definitif et n'est propose qu'a l'inscription) -> Settings ->
# Project -> Project API Key. Format : phc_xxxxxxxx.
# Offre gratuite : 1 M d'evenements et 5 000 rejeux de session par mois, sans
# carte bancaire. Le volume attendu ici est de deux a trois ordres de grandeur
# en dessous.
NEXT_PUBLIC_POSTHOG_KEY=

# Hote d'INGESTION PostHog. Vide = https://eu.i.posthog.com, c'est-a-dire
# l'Union europeenne. Ne jamais pointer vers us.i.posthog.com : le site est
# francais, sa cible aussi, et un transfert hors UE devrait etre documente dans
# la politique de confidentialite.
# PIEGE : eu.i.posthog.com est l'ingestion, eu.posthog.com est l'interface. Les
# intervertir donne un proxy qui repond 200 en servant du HTML.
NEXT_PUBLIC_POSTHOG_HOST=

# ---------------------------------------------------------------------------
# GOOGLE SEARCH CONSOLE
#
# Jeton de la balise <meta name="google-site-verification">. Vide = aucune
# balise rendue. Public par nature, il ne prouve que le controle du site.
#
# OU LE TROUVER : search.google.com/search-console -> Ajouter une propriete ->
# Prefixe d'URL -> https://www.eliottbouquerel.fr -> methode "Balise HTML" ->
# copier la SEULE valeur de l'attribut content, sans la balise autour.
# Procedure complete, etape par etape : docs/ANALYTICS.md.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─────────────────────────── Formulaires de contact ──────────────────────────
# Les trois formulaires du site (page contact, pied de page, bloc du blog)
# postent sur `POST /api/contact`. La route REFUSE de servir tant que les deux
# services ci-dessous ne sont pas configurés : elle répond 503 avec un message
# honnête plutôt que d'afficher « envoyé » sans avoir rien envoyé.
# Procédure complète, DNS compris : `docs/EMAIL.md`.

# Resend — envoi des e-mails (compte PERSONNEL d'Eliott, pas celui d'un ancien
# projet). Clef à créer sur https://resend.com/api-keys, portée « Sending
# access » suffit. SANS ELLE, aucun message ne part : la route répond 503.
# Offre gratuite : 3 000 e-mails par mois, 100 par jour. Aucune carte demandée.
RESEND_API_KEY=

# Expéditeur affiché. Le domaine DOIT être vérifié chez Resend, sinon l'envoi
# est refusé. Valeur par défaut si vide : `Eliott Bouquerel
# <contact@eliottbouquerel.fr>`.
CONTACT_FROM_EMAIL=

# Boîte qui reçoit les notifications. Vide = contact@eliottbouquerel.fr.
CONTACT_TO_EMAIL=

# ── Chemin de repli : SMTP ───────────────────────────────────────────────────
# ORDRE DE CHOIX, decide par src/lib/contact/mailer.ts : RESEND_API_KEY posee
# l'emporte toujours ; a defaut, si les trois variables SMTP_* obligatoires
# ci-dessous sont posees, le message part par SMTP ; sinon la route repond 503
# et le formulaire affiche son message honnete. Les deux chemins envoient
# EXACTEMENT le meme contenu, compose par src/lib/contact/emails.ts.
#
# POURQUOI CE CHEMIN EXISTE. Resend n'ecrit a un tiers qu'une fois le domaine
# verifie par DNS : compte a creer, enregistrements a poser chez l'hebergeur,
# propagation a attendre. Tant que ce n'est pas fait, l'accuse de reception au
# prospect ne part pas. Un compte de messagerie dont l'alias est deja verifie
# envoie, lui, des aujourd'hui. Le site n'attend pas le DNS pour accepter un
# message.
#
# CONNEXION CHIFFREE DES L'OUVERTURE (TLS implicite, port 465). STARTTLS n'est
# volontairement pas gere : un port en clair qu'on promeut ensuite ajoute un
# mode degrade qu'on ne saurait pas tester.
#
# LE MOT DE PASSE EST UN SECRET. Il ne vit que dans .env.local (0600, ignore
# par Git) ou dans le gestionnaire de secrets du service. Jamais ici, jamais
# dans un commentaire, jamais dans un test.
#
# Exemple de valeurs (FACTICES, a remplacer) :
#   SMTP_HOTE=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_UTILISATEUR=prenom.nom@gmail.com
#   SMTP_MOT_DE_PASSE=abcd efgh ijkl mnop
#   CONTACT_FROM_EMAIL=Eliott Bouquerel <contact@eliottbouquerel.fr>
#
# AVEC GMAIL, deux conditions : la validation en deux etapes doit etre active
# sur le compte (sinon aucun mot de passe d'application n'est proposable), et
# l'adresse de CONTACT_FROM_EMAIL doit figurer dans « Envoyer des e-mails en
# tant que » et y etre verifiee, sinon Gmail reecrit l'expediteur.
# Le mot de passe d'application se cree sur
# https://myaccount.google.com/apppasswords : ce n'est PAS le mot de passe du
# compte, et il se revoque seul, sans toucher au compte.

# Serveur SMTP. Vide = chemin SMTP desactive.
SMTP_HOTE=

# Port en TLS implicite. Vide = 465.
SMTP_PORT=

# Compte AUTHENTIFIE aupres du serveur. Ce n'est pas forcement l'adresse
# affichee : avec un alias verifie, on s'authentifie avec le compte et on
# affiche l'alias via CONTACT_FROM_EMAIL.
SMTP_UTILISATEUR=

# Mot de passe d'application. SECRET.
SMTP_MOT_DE_PASSE=

# Cloudflare Turnstile — vérification anti-robot, sans cookie de suivi (choix
# argumenté dans `src/lib/contact/captcha.ts`). Les deux clefs se récupèrent sur
# https://dash.cloudflare.com > Turnstile > Add site. Gratuit, sans carte.
# SANS ELLES, le formulaire s'affiche mais annonce explicitement qu'il est
# indisponible et renvoie vers l'adresse e-mail : il n'accepte JAMAIS tout en
# silence.
# Clefs de TEST publiques de Cloudflare, pour le développement local :
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ──────────────────────── Prise de rendez-vous — Cal.com ─────────────────────
# Le bloc « Réserver un créneau » de /contact appelle NOS routes
# `GET /api/rendez-vous/creneaux` et `POST /api/rendez-vous`, jamais Cal.com
# depuis le navigateur. Les deux points de terminaison v2 employés répondent
# SANS clef d'API : il n'y a donc aucun secret Cal.com à poser ici.
#
# ABSENCE DE VALEUR = BLOC MASQUÉ, SITE INTACT. Sans ces variables, la section
# ne se rend pas du tout (pas de cadre vide, pas de message d'attente) et les
# deux routes répondent 503 avec un message honnête. C'est l'état par défaut du
# dépôt, et il est testé (`src/lib/rendez-vous/config.test.mjs`).
#
# ATTENTION : ces variables sont lues au RENDU. Sur une page prérendue à la
# construction, leur valeur y est figée — les poser ne suffit pas, il faut
# redéployer. Procédure complète, création des quatre types d'événements
# comprise : `docs/CAL-COM.md`.

# Nom d'utilisateur Cal.com, celui de l'URL publique `cal.com/<username>`.
# OBLIGATOIRE si les variables ci-dessous portent des SLUGS ; inutile si elles
# portent des identifiants numériques.
CAL_COM_USERNAME=

# Un type d'événement Cal.com par type de rendez-vous proposé sur le site.
# Chaque variable accepte AU CHOIX :
#   - le SLUG lu dans l'URL publique (`cal.com/<username>/site-20min` -> `site-20min`),
#     auquel cas CAL_COM_USERNAME est requis ;
#   - l'IDENTIFIANT numérique, lu dans l'URL de l'écran d'édition
#     (`app.cal.com/event-types/1234567` -> `1234567`), qui se suffit à lui-même
#     et survit à un renommage.
# Une variable laissée vide retire simplement SON entrée du sélecteur : les
# autres continuent de fonctionner.
CAL_COM_EVENT_SITE=
CAL_COM_EVENT_OUTIL=
CAL_COM_EVENT_LOGICIEL=
CAL_COM_EVENT_DECOUVERTE=

# ───────────────── Clics des liens de prospection : cockpit ──────────────────
# Jeton Bearer que `/r/<id>` envoie au cockpit (admin.eliottbouquerel.fr) pour
# enregistrer un clic. SECRET, serveur uniquement. Vide = aucun clic
# enregistre, la redirection fonctionne quand meme.
CLIC_TOKEN=
